	(text "NOTES:"
		(exclude_from_sim no)
		(at 184.15 224.79 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6c172f5a-fe8d-4899-b5da-84abc77de94a")
	)
	(text "1. U1 Mini560 = custom symbol (weather-power:Mini560) - Vin+/Vin-/Vout+/Vout-."
		(exclude_from_sim no)
		(at 184.15 229.87 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "203e16bb-ead0-4e07-ab76-cd0470bc2703")
	)
	(text "2. IRF4905 + 2N7000 MOSFET switch -> 12V_SW. GPIO15 HIGH = ON. R1=10k keeps OFF."
		(exclude_from_sim no)
		(at 184.15 234.95 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ee746242-3b89-4936-90ba-e548282955b3")
	)
	(text "3. Divider R3=390k + R4=100k -> BAT_ADC (GPIO14), ratio 4.90 (4S LiFePO4)."
		(exclude_from_sim no)
		(at 184.15 240.03 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "89cf4178-ec59-463a-a5ad-c0d17fa5de03")
	)
	(text "4. I2C: BME280 (0x76) + LTR390 (0x53) share SDA(GPIO1)/SCL(GPIO2). R5/R6 = 4.7k."
		(exclude_from_sim no)
		(at 184.15 245.11 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ab524091-ea3e-4775-82f2-f984c17ec78e")
	)
	(text "5. OneWire DS18B20 on GPIO3 (R7=4.7k). Rain=GPIO10, Soil=GPIO13."
		(exclude_from_sim no)
		(at 184.15 250.19 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c921d6a2-6c9f-4409-a455-6c12fc720d3d")
	)
	(text "6. RS485 wind (shared A/B): MAX485E DI=GPIO17, RO=GPIO18, DE+RE=GPIO16."
		(exclude_from_sim no)
		(at 184.15 255.27 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5e2674cc-e586-4ebf-bf6d-9cd9ed30343d")
	)
	(text "   Wind sensor power via 12V_SW (NOT through ESP32)."
		(exclude_from_sim no)
		(at 184.15 260.35 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e4c04d11-c1fb-48fa-a918-644bc87452df")
	)
	(text "7. E22-900T22D: M0=GPIO4 M1=GPIO5 RXD=GPIO6 TXD=GPIO7 AUX=GPIO8; VCC=5V; C4=470uF C5=100nF."
		(exclude_from_sim no)
		(at 184.15 265.43 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "331b6cf8-cd5d-476c-a4c9-a977bbe9931d")
	)
	(text "8. U5 uses Jim's custom ESP32-S3-N16R8 44-pin symbol (two physical 1x22 headers)."
		(exclude_from_sim no)
		(at 184.15 270.51 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "620751b7-2736-46bf-a426-5ffcc482a77a")
	)
