	(text "[ INPUT & PROTECTION ]"
		(at 19.05 8.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bc978e9a-d3c2-4a0e-a0b0-2ce944800421")
	)
	(text "[ 5V BUCK + 3.3V LDO ]"
		(at 95.25 8.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5a70182c-c78c-47a7-a60b-cea5f9c16556")
	)
	(text "[ MOSFET SWITCH + DIVIDER ]"
		(at 171.45 8.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "85053ce2-44cb-468a-a46c-eaa2c7dea1c0")
	)
	(text "[ OUTPUT ]"
		(at 285.75 8.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a5583cf3-ab5b-42a0-9cc0-096e70665312")
	)
	(text "[ ESP32-S3 N16R8 ]"
		(at 171.45 97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5a2e3799-9ddc-4959-b9bb-aeb49c43fb19")
	)
	(text "[ E22 UART LoRa ]"
		(at 69.85 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4747c460-b1c8-4479-b088-b3efd33bd9db")
	)
	(text "[ RS485 ]"
		(at 323.85 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1f6da12f-d2bb-40f3-967a-8df73dde5c3d")
	)
	(text "[ SENSORS ]"
		(at 19.05 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ba881795-457f-4de4-a5a5-cfede802b58a")
	)
	(text "NOTES:"
		(at 184.15 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0d9b10fc-a883-457b-8900-5b4f21f0dc11")
	)
	(text "1. U1 Mini560 is the FINAL 12V-to-5V power module; verify 5.0V before connecting loads."
		(at 184.15 229.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "761e73fa-e189-458f-a240-cc30b1273085")
	)
	(text "2. IRF4905 + 2N7000 MOSFET switch -> 12V_SW. GPIO15 HIGH = ON. R1=10k keeps OFF."
		(at 184.15 234.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ac127dc0-fed4-4fab-9766-c4fe65aef37e")
	)
	(text "3. R3=390k + R4=100k -> BAT_ADC (GPIO14), ratio 4.90; C6=100nF filters ADC noise."
		(at 184.15 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "36d9f17c-f2b8-483d-aa77-4b378914b4a1")
	)
	(text "4. I2C: BME280 (0x76) + LTR390 (0x53) share SDA(GPIO1)/SCL(GPIO2). R5/R6 = 4.7k."
		(at 184.15 245.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d53db45c-0d3d-4364-a3fc-596baa862dc4")
	)
	(text "5. DS18B20=GPIO3 (R7=4.7k). Rain=GPIO10 with R11=10k/C8=100nF. Soil=GPIO13."
		(at 184.15 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "01d9426e-54cd-4f52-b68f-2e2ba69ecd16")
	)
	(text "6. Auto RS485: VCC=3V3; GPIO17 TX->RXD, TXD->GPIO18 RX (PROVISIONAL: verify directions)."
		(at 184.15 255.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "feb4bc4c-2486-4a2a-846a-2f5983dc9674")
	)
	(text "   GPIO16 unused. Earth separate from TTL GND. Wind sensor power=12V_SW."
		(at 184.15 260.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9d747e88-230d-4f71-9be7-d71975294c63")
	)
	(text "7. E22-900T22D: M0=GPIO4 M1=GPIO5 RXD=GPIO6 TXD=GPIO7 AUX=GPIO8; VCC=5V; C4=470uF C5=100nF."
		(at 184.15 265.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c73add6b-11d6-4a08-9cd9-f1fd3ff0b481")
	)
	(text "8. U5 uses Jim's custom ESP32-S3-N16R8 44-pin symbol (two physical 1x22 headers)."
		(at 184.15 270.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "11c2b0be-c78c-47ac-b3f1-883f7bf5aea0")
	)
	(text "9. C7=100nF at VCC/GND. R10=120R DNP; fit only at bus end if onboard termination absent."
		(at 184.15 275.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c27ecb74-3bff-4085-8cb0-058bbd563626")
	)
